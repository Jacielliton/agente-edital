OPENROUTER_API_KEY=SEU_TOKEN_AQUI

DEFAULT_MODEL=openrouter/aurora-alpha
AVAILABLE_MODELS=openrouter/aurora-alpha,openrouter/openai/gpt-4o-mini

ENV_FILE_PATH=.env




# Obrigatoria. Assina os tokens de sessao (JWT).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# CORS: origens que podem chamar esta API, separadas por vírgula.
# Em produção, liste apenas os domínios reais do site.
CORS_ORIGINS=https://agente-edital.tecnopriv.top,http://localhost:5173

# Limite de requisições. Vazio ou 0 desliga (não recomendado em produção).
RATE_LIMIT_ATIVO=1

# ATENÇÃO: este arquivo VAI para o git. Nunca cole chave real aqui — só o nome
# da variável. Cinco chaves da OpenRouter ficaram expostas assim até 08/09/2026.
